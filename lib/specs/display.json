{
  "$comment": "Alma Media display advertising formats. Sizes are Alma's own display format table (Standard / Taktiset / Erikoisratkaisut), grouped by the product name a media buyer books and by device. width/height is the size this tool renders; alternateSizes are the other sizes Alma accepts for the same product and are not generated. Format names are Alma's own and are kept as-is. Character limits are this tool's template-level limits (legibility at a given size), not Alma requirements: Alma specifies character limits only for Performance Native.",
  "source": {
    "url": "https://www.almamedia.fi/mainostajat/aineisto-ohjeet/display-mainonnan-aineisto-ohjeet/",
    "fetchedAt": "2026-08-11"
  },
  "global": {
    "aiActLabel": "Created with AI",
    "$aiActComment": "Turned off by an AMR decision: images are cropped rather than altered, and every line of copy is reviewed by a person before download. Note that ad headlines, body copy and CTAs are written by the model — if that decision changes, setting this back to true restores the label in both the rendered assets and the validation. If the label is turned on for ads running in Finnish media, translate aiActLabel as well: the disclosure has to read in the language of the ad.",
    "requireAiActLabel": false,
    "httpsRequired": true,
    "acceptedStaticFormats": [
      "jpg",
      "png",
      "gif"
    ],
    "html5": {
      "maxInitialLoadKb": 300,
      "maxCpuLoadPercent": 20,
      "politeLoadAllowed": true,
      "notes": [
        "All external resources must load over HTTPS.",
        "The cursor must change over clickable areas.",
        "Links open in a new tab.",
        "Initial load stays within the file size limit; polite load is allowed after window.onload.",
        "Avoid jQuery because of its file weight.",
        "Google Web Designer: choose the Non-Google Ad setting."
      ]
    }
  },
