# Copy this to .env.local and fill in the keys.

# Anthropic API key. Without it the app uses mock data and the pipeline still works.
ANTHROPIC_API_KEY=

# Optional: change the model. Default is claude-sonnet-4-6.
# A higher-quality option: claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: fal.ai key for video generation (behind a feature flag, not required).
FAL_KEY=
ENABLE_VIDEO=false

# --- Xandr (adserver) -------------------------------------------------------
# Booking is skipped entirely when the username and password are missing.
# There is one Xandr host. "Staging" is the test member (13720) on that same
# host; the live member is 6931. api-test.appnexus.com is dead and 404s.
XANDR_BASE_URL=https://api.appnexus.com
XANDR_MEMBER_ID=13720
XANDR_USERNAME=
XANDR_PASSWORD=

# The Xandr advertiser the line item is booked under, and the insertion order
# it hangs from. Both are supplied by AMS Ad Ops; neither is created by us.
XANDR_ADVERTISER_ID=
XANDR_INSERTION_ORDER_ID=
