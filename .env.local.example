# Kopioi tämä tiedostoksi .env.local ja täytä avaimet.

# Anthropic API -avain. Jos puuttuu, sovellus käyttää mock-dataa ja putki toimii silti.
ANTHROPIC_API_KEY=

# Valinnainen: vaihda malli. Oletus claude-sonnet-4-6.
# Laadukkaampi vaihtoehto: claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-4-6

# Valinnainen: fal.ai-avain videogenerointiin (feature flagin takana, ei pakollinen).
FAL_KEY=
ENABLE_VIDEO=false
